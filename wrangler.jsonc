{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "claude-workers-ai-proxy",
    "main": "src/index.ts",
    "compatibility_date": "2026-08-27",
    "workers_dev": true,
    "preview_urls": false,
    // This file is the source of truth for non-sensitive config: dashboard vars are
    // deleted on deploy; secrets (PROXY_KEY) are not. Add vars as new keys inside the
    // "vars" block below, next to MODELS and MODEL_ROUTES (keep those, or the shipped
    // models are lost), e.g. "ALLOWED_HOSTS": "api.openai.com". Values are strings. Defaults:
    //   ALLOWED_HOSTS     api.openai.com, generativelanguage.googleapis.com, api.anthropic.com,
    //                     openrouter.ai, api.groq.com, api.deepseek.com, api.mistral.ai, api.x.ai
    //                     ("*" allows any host)
    //   ALLOW_HTTP        false  (http:// provider URLs are rejected)
    //   ALLOW_ANONYMOUS   false  (without PROXY_KEY the proxy refuses requests)
    //   MAX_BODY_BYTES    33554432  (32 MiB)
    //   UPSTREAM_TTFB_MS  120000  (time to first byte)
    //   UPSTREAM_TOTAL_MS 600000  (per-attempt limit, non-streaming; retries can exceed it)
    //   MODELS            the shipped value below (comma-separated model ids)
    //   MODEL_ROUTES      the shipped value below (JSON route table). Route keys beyond
    //                     provider/model: contextTokens (window reported by GET /v1/models,
    //                     default 24000), reasoning (thinking capability, default false),
    //                     vision and multiTool (override VISION_MODELS / MULTI_TOOL_MODELS).
    //                     An alias route inherits unset settings from the route keyed by its
    //                     model on the same provider (one hop).
    //   DRAFT_MODEL       none  (default model for MCP purple draft_rule; else the first /v1/models entry)
    //   JUDGE_MODEL       none  (default judge for MCP redteam; judgeModel "" turns it off)
    //   VISION_MODELS     none (comma-separated model ids)
    //   MULTI_TOOL_MODELS none (comma-separated model ids)
    //   CF_ACCOUNT_ID     none  (var; your 32-hex account id, enables the MCP `logs` tool)
    //   OBSERVABILITY_SERVICE claude-workers-ai-proxy  (var, optional; Worker name `logs` filters on)
    // Secrets: PROXY_KEY and CF_API_TOKEN (set with `npx wrangler secret put <NAME>`).
    "vars": {
        "MODELS": "@cf/zai-org/glm-5.3,@cf/moonshotai/kimi-k2.6,@cf/deepseek-ai/deepseek-v4-pro-0813",
        "MODEL_ROUTES": "{\"@cf/zai-org/glm-5.3\":{\"provider\":\"workers-ai\",\"model\":\"@cf/zai-org/glm-5.3\",\"contextTokens\":1048576,\"reasoning\":true},\"@cf/moonshotai/kimi-k2.6\":{\"provider\":\"workers-ai\",\"model\":\"@cf/moonshotai/kimi-k2.6\",\"contextTokens\":262144,\"reasoning\":true},\"@cf/deepseek-ai/deepseek-v4-pro-0813\":{\"provider\":\"workers-ai\",\"model\":\"@cf/deepseek-ai/deepseek-v4-pro-0813\",\"contextTokens\":1048576,\"reasoning\":true}}"
    },
    "observability": {
        "enabled": true
    },
    "compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
    "ai": {
        "binding": "AI",
        "remote": true
    },
    "ratelimits": [
        {
            "name": "RATE_LIMITER",
            "namespace_id": "1001",
            "simple": { "limit": 100, "period": 60 }
        }
    ]
}

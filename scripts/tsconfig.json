{
    "compilerOptions": {
        "target": "es2022",
        "lib": ["es2023", "dom"],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "allowImportingTsExtensions": true,
        "erasableSyntaxOnly": true,
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "types": ["node"]
    },
    "include": ["./**/*.ts", "../claude-code/**/*.ts"]
}

{
    "name": "claude-worker-proxy",
    "version": "0.0.0",
    "license": "MIT",
    "scripts": {
        "deploy": "wrangler types && prettier --write . && wrangler deploy",
        "dev": "wrangler types && prettier --write . && wrangler dev --port 8080",
        "check": "wrangler types && tsc --noEmit && tsc -p test/tsconfig.json --noEmit && prettier --check .",
        "test": "vitest run"
    },
    "devDependencies": {
        "@cloudflare/vitest-pool-workers": "^0.23.0",
        "@types/node": "^26.4.1",
        "prettier": "^3.6.2",
        "typescript": "^5.5.2",
        "vitest": "^4.1.12",
        "wrangler": "^4.21.0"
    }
}

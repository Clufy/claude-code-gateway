{
    "name": "claude-code-gateway",
    "version": "1.0.0",
    "private": true,
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Clufy/claude-code-gateway.git"
    },
    "scripts": {
        "deploy": "wrangler types && prettier --write . && wrangler deploy",
        "dev": "wrangler types && prettier --write . && wrangler dev --port 8080",
        "check": "wrangler types && tsc --noEmit && tsc -p test/tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit && prettier --check .",
        "test": "vitest run --project workers --project node",
        "bench": "vitest run --project bench",
        "smoke": "bash scripts/self-test.sh",
        "update-psl": "node scripts/update-psl.ts",
        "qualify": "node scripts/qualify/index.ts",
        "qualify:capture": "node scripts/qualify/capture.ts",
        "redteam": "node scripts/redteam/index.ts"
    },
    "devDependencies": {
        "@cloudflare/vitest-plugin": "^1.6.0",
        "@types/node": "^26.4.1",
        "prettier": "^3.6.2",
        "typescript": "^5.5.2",
        "vitest": "^4.1.12",
        "wrangler": "^4.21.0"
    },
    "dependencies": {
        "@cfworker/json-schema": "^4.1.6",
        "@modelcontextprotocol/sdk": "1.32.2",
        "yaml": "2.9.1",
        "zod": "^4.6.7"
    },
    "cloudflare": {
        "bindings": {
            "PROXY_KEY": {
                "description": "Required. The key Claude Code sends in the `x-api-key` header; requests without it are refused. Use a long random value and keep it secret."
            }
        }
    }
}
